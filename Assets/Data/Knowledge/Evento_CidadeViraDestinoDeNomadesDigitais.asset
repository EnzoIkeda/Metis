  m_Script: {fileID: 11500000, guid: f424be585f9e04c79a96c8292e8b9db1, type: 3}
  m_Name: Evento_CidadeViraDestinoDeNomadesDigitais
  m_EditorClassIdentifier: Metis.Runtime::KnowledgeEntryData
  _title: "Cidade Vira Destino de N\xF4mades Digitais"
  _titleEn: City Becomes a Digital Nomad Hub
  _category: 1
  _unlockTrigger: 0
  _summary: "Profissionais que trabalham pela internet escolhem morar em cidades
    com bom clima, custo baixo e boa conex\xE3o."
  _summaryEn: Professionals who work online choose to live in cities with good weather,
    low costs and good connectivity.
  _realWorld: "Lisboa, Medell\xEDn e outras cidades atra\xEDram n\xF4mades digitais
    e viram os alugu\xE9is subir; v\xE1rios pa\xEDses criaram vistos espec\xEDficos
    para eles."
  _realWorldEn: "Lisbon, Medell\xEDn and other cities attracted digital nomads and
    saw rents rise; several countries created specific visas for them."
  _tradeOffs: "Traz renda e movimento, mas pode encarecer a moradia para quem j\xE1
    vivia ali."
  _tradeOffsEn: It brings income and activity, but can make housing more expensive
    for those who already lived there.
  _sources:
  - Label: Digital nomad (Wikipedia)
    Url: https://en.wikipedia.org/wiki/Digital_nomad

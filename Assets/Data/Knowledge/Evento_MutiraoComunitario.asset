  m_Name: Evento_MutiraoComunitario
  m_EditorClassIdentifier: Metis.Runtime::KnowledgeEntryData
  _title: "Mutir\xE3o Comunit\xE1rio"
  _titleEn: Community Work Party
  _category: 1
  _unlockTrigger: 0
  _summary: "No mutir\xE3o, moradores se organizam para construir ou melhorar algo
    juntos, como casas, pra\xE7as ou hortas."
  _summaryEn: "In a mutir\xE3o, residents organize to build or improve something
    together, such as homes, squares or gardens."
  _realWorld: "Movimentos de moradia de S\xE3o Paulo constru\xEDram milhares de casas
    em mutir\xF5es autogeridos, com apoio p\xFAblico, a partir dos anos 1980 e 1990."
  _realWorldEn: "Housing movements in S\xE3o Paulo built thousands of homes in self-managed
    work parties, with public support, starting in the 1980s and 1990s."
  _tradeOffs: "Depende de tempo livre dos moradores e de apoio t\xE9cnico e material
    para dar certo."
  _tradeOffsEn: It depends on residents' free time and on technical and material
    support to succeed.
  _sources:
  - Label: "Mutir\xE3o (Wikip\xE9dia)"
    Url: https://pt.wikipedia.org/wiki/Mutir%C3%A3o
